# ============================================================
# Hyprland Config
# ============================================================

# --- Environment Variables (applied before anything else) ---
env = XCURSOR_SIZE,24
env = XCURSOR_THEME,Adwaita

# Input Method — Rime via Fcitx5
env = GTK_IM_MODULE,fcitx
env = QT_IM_MODULE,fcitx
env = XMODIFIERS,@im=fcitx
env = SDL_IM_MODULE,fcitx
# GLFW (games, etc.)
env = GLFW_IM_MODULE,ibus

# QT Wayland
env = QT_QPA_PLATFORM,wayland;xcb
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1

# GDK / GTK
env = GDK_BACKEND,wayland,x11

# Native Wayland for Electron apps (Chrome, etc.)
env = ELECTRON_OZONE_PLATFORM_HINT,auto
env = NIXOS_OZONE_WL,1

# --- Monitor ---
# Auto-detect. Override with:
# monitor = eDP-1, 1920x1080@60, 0x0, 1
monitor = , preferred, auto, 1

# --- Cursor ---
cursor {
    inactive_timeout = 3
}

# --- Execute at launch ---
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = fcitx5 -d
exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec-once = waybar
exec-once = swaybg -i ~/.config/hypr/wallpaper.jpg -m fill 2>/dev/null || true
exec-once = nm-applet --indicator
exec-once = nextcloud
exec-once = blueman-applet
exec-once = cliphist store
exec-once = /usr/lib/geoclue-2.0/demos/agent

# --- Input ---
input {
    # Keyboard
    kb_layout = us
    kb_variant =
    kb_model =
    kb_options =
    kb_rules =

    # Repeat rate
    repeat_rate = 40
    repeat_delay = 250

    # Touchpad
    touchpad {
        natural_scroll = true
        tap-to-click = true
        tap-and-drag = false
        disable_while_typing = true
        middle_button_emulation = false
    }

    # Mouse
    accel_profile = flat
    sensitivity = 0
}

# --- General ---
general {
    # Gaps around windows
    gaps_in = 4
    gaps_out = 8
    border_size = 2
    layout = dwindle

    # Colors
    col.active_border = rgba(7fbbbcee) rgba(5e81acee) 45deg
    col.inactive_border = rgba(4c566a88)

    # Resize
    resize_on_border = true
    extend_border_grab_area = 15
    hover_icon_on_border = true

    # Allow tearing (lower latency in fullscreen)
    allow_tearing = false
}

# --- Decoration ---
decoration {
    # Rounding
    rounding = 8

    # Drop shadows
    shadow {
        enabled = true
        range = 6
        render_power = 2
        color = rgba(1a1a2e88)
    }

    # Blur
    blur {
        enabled = true
        size = 4
        passes = 2
        ignore_opacity = false
        noise = 0.01
        contrast = 0.9
        brightness = 0.9
        vibrancy = 0.2
        popups = true
        popups_ignorealpha = 0.2
    }
}

# --- Animations ---
animations {
    enabled = true
    bezier = wind, 0.05, 0.9, 0.1, 1.05
    bezier = winIn, 0.1, 1.0, 0.1, 1.1
    bezier = winOut, 0.0, 0.0, 0.2, 1.0
    bezier = liner, 1.0, 1.0, 1.0, 1.0

    animation = windows, 1, 6, wind, slide
    animation = windowsIn, 1, 6, winIn, slide
    animation = windowsOut, 1, 5, winOut, slide
    animation = windowsMove, 1, 5, wind, slide
    animation = fade, 1, 4, liner
    animation = fadeDim, 1, 5, liner
    animation = workspaceChange, 1, 4, liner
    animation = border, 1, 5, liner
}

# Dwindle settings
dwindle {
    pseudotile = true
    preserve_split = true
    force_split = 0
    special_scale_factor = 0.8
    split_width_multiplier = 1.0
    no_gaps_when_only = true
    smart_split = false
    smart_resizing = true
}

# Master settings
master {
    allow_small_split = true
    always_center_master = true
    orientation = left
    mfact = 0.55
    new_is_master = true
    new_on_active = true
    new_on_top = true
    smart_count = 3
    smart_resizing = true
    drop_at_cursor = true
}

# --- Window Rules ---
windowrule = float, class:(pavucontrol)
windowrule = float, class:(nm-connection-editor)
windowrule = float, class:(blueman-manager)
windowrule = float, title:(Picture-in-Picture)
windowrule = float, title:(Firefox — Sharing Indicator)
windowrule = opacity 0.95 override 0.95 override, class:(Alacritty)
windowrule = opacity 0.95 override 0.95 override, class:(firefox)
windowrule = workspace 1 silent, class:(Alacritty)
windowrule = workspace 2 silent, class:(firefox)
windowrule = workspace 3 silent, class:(google-chrome)
windowrule = workspace 5 silent, class:(Telegram)
windowrule = workspace 6 silent, class:(org.keepassxc.KeePassXC)
windowrule = workspace 7 silent, class:(org.gnome.Nautilus)
windowrule = workspace 7 silent, class:(pcmanfm)
windowrule = workspace 8 silent, class:(org.gnome.Software) || class:(pamac-manager)
windowrule = noblur, class:(swaybg)
windowrule = noblur, class:(waybar)

# --- Keybindings ---
$mainMod = SUPER

# Basic
bind = $mainMod, Return, exec, alacritty
bind = $mainMod, Q, killactive,
bind = $mainMod, F, fullscreen, 0
bind = $mainMod, Space, togglefloating,
bind = $mainMod, P, pseudo,       # dwindle: toggle pseudotile
bind = $mainMod, J, togglesplit,  # dwindle: toggle split direction

# Rofi/Wofi app launcher
bind = $mainMod, D, exec, wofi --show drun

# Screenshots
bind = , Print, exec, hyprshot -m region
bind = $mainMod, Print, exec, hyprshot -m window
bind = $mainMod SHIFT, Print, exec, hyprshot -m output

# Clipboard manager
bind = $mainMod, V, exec, cliphist list | wofi --dmenu | cliphist decode | wl-copy

# Lock screen
bind = $mainMod SHIFT, L, exec, swaylock

# Close window (handled above under # Basic)

# Focus
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d

# Move windows
bind = $mainMod SHIFT, left, movewindow, l
bind = $mainMod SHIFT, right, movewindow, r
bind = $mainMod SHIFT, up, movewindow, u
bind = $mainMod SHIFT, down, movewindow, d

# Resize windows
bind = $mainMod, R, submap, resize

# Workspaces
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

# Move window to workspace
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Scroll through workspaces
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

# Move to special workspace (scratchpad)
bind = $mainMod, S, togglespecialworkspace
bind = $mainMod SHIFT, S, movetoworkspace, special

# Volume (pavucontrol for GUI)
bind = , XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bind = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bind = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bind = , XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Brightness
bind = , XF86MonBrightnessUp, exec, brightnessctl s +5%
bind = , XF86MonBrightnessDown, exec, brightnessctl s 5%-

# Screenshot
bind = , XF86Search, exec, wofi --show drun

# --- Resize Submap ---
submap = resize
binde = , left, resizeactive, -10 0
binde = , right, resizeactive, 10 0
binde = , up, resizeactive, 0 -10
binde = , down, resizeactive, 0 10
bind = , escape, submap, reset
bind = , Return, submap, reset
submap = reset

# --- Misc ---
# Misc settings
misc {
    disable_autoreload = true
    enable_swallow = true
    swallow_regex = ^(Alacritty)$
    focus_on_activate = true
    animate_manual_resizes = true
    mouse_move_enables_dpms = true
    key_press_enables_dpms = true
}

# --- XWayland ---
xwayland {
    enabled = true
}

# --- Window manager specific ---
# Gestures
gestures {
    workspace_swipe = true
    workspace_swipe_forever = true
    workspace_swipe_distance = 300
    workspace_swipe_invert = false
}

# --- Plugin (if any) ---
# Example: window rule to ignore Hyprspace (workspace overview)
# plugin {
#     hyprspace {
#         overview_gradient = true
#         overview_center_aligned = false
#         overview_behind_panel = false
#         overview_panel_position = bottom
#     }
# }
