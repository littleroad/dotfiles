{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": ["tray", "pulseaudio", "battery", "clock"],

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 2
    }
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "🔇",
    "format-icons": {
      "default": ["🔈", "🔉", "🔊"]
    },
    "on-click": "pavucontrol"
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "ACAD",
    "format": "{icon} {capacity}%",
    "format-icons": ["🔋", "🔋", "🔋", "🔋", "🔋"],
    "format-charging": "⚡ {capacity}%",
    "format-plugged": "🔌 {capacity}%",
    "format-full": "🔋 100%",
    "tooltip": true
  },

  "clock": {
    "format": "{:%a %Y/%m/%d %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffb3b3'><b>{}</b></span>",
        "days": "<span color='#e6e6e6'><b>{}</b></span>",
        "weeks": "<span color='#99ff99'><b>W{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode"
    }
  }
}